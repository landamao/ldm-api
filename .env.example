# 懒大猫 API 配置示例
#
# 复制为 .env 后按需修改。程序启动时会自动读取当前工作目录或可执行文件同级的 .env。
# 优先级：命令行参数 > 真实环境变量 > .env > 默认值。

# 监听地址与端口
LDMAPI_HOST=127.0.0.1
LDMAPI_PORT=6700

# 数据目录；留空则使用可执行文件同级的 data 目录。
# 相对路径以启动时的工作目录为准。
# LDMAPI_DATA=/opt/ldmapi/data

# 启动时把管理端密码重置为下面这个值：这里填的是密码本身，不是开关。
# 密码至少 6 位；不设置或留空则保持原有密码。
# LDMAPI_PASSWORD=你的新密码

# 启动后自动打开浏览器（1/true/yes/on 视为开启）
LDMAPI_OPEN=false

# 前端资源目录，开发时直接从磁盘读取（如 web）
# LDMAPI_DEV=web

# 指定其它 .env 文件路径。
# 只能通过真实环境变量设置，不能写在 .env 里。
# LDMAPI_ENV_FILE=/etc/ldmapi.env
